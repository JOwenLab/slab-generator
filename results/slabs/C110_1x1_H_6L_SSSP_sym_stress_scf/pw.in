! Stress-only SCF generated from results/slabs/C110_1x1_H_6L_SSSP_sym
! Uses final relaxed coordinates; no ionic relaxation.
&CONTROL
  tprnfor       = .true.
  tstress       = .true.
  calculation   = 'scf'
  prefix        = 'slab'
  pseudo_dir    = './'
  outdir        = './tmp'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-5
/

&SYSTEM
  ibrav    = 0
  nat      = 16
  ntyp     = 2
  ecutwfc  = 60.0
  ecutrho  = 480.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
/

&ELECTRONS
  conv_thr    = 1.0d-8
  mixing_beta = 0.3
/

