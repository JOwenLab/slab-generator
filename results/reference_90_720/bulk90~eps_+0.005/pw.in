! bulk diamond SCF  eps=+0.0050 — bulkgen.py
! a = a0*(1+eps) = 3.58483500 Ang  functional=PBE
! verify pseudo, cutoffs, and k-mesh against your convergence tests
&CONTROL
  calculation   = 'scf'
  prefix        = 'diamond'
  pseudo_dir    = './'
  outdir = '/tmp/qe'
  tstress       = .true.
  tprnfor       = .true.
/
&SYSTEM
  ibrav    = 0
  nat      = 8
  ntyp     = 1
  ecutwfc  = 90.0
  ecutrho  = 720.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.4
/
ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
      3.58483500     0.00000000     0.00000000
      0.00000000     3.58483500     0.00000000
      0.00000000     0.00000000     3.58483500
ATOMIC_POSITIONS crystal
  C  0.00000000  0.00000000  0.00000000
  C  0.25000000  0.25000000  0.25000000
  C  0.50000000  0.50000000  0.00000000
  C  0.75000000  0.75000000  0.25000000
  C  0.50000000  0.00000000  0.50000000
  C  0.75000000  0.25000000  0.75000000
  C  0.00000000  0.50000000  0.50000000
  C  0.25000000  0.75000000  0.75000000
K_POINTS automatic
  8 8 8  0 0 0
