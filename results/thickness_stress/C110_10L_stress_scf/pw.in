! Stress-only SCF generated from results/thickness/C110_10L
! Uses final relaxed coordinates; no ionic relaxation.
&CONTROL
  tprnfor       = .true.
  tstress       = .true.
  calculation   = 'scf'
  prefix        = 'slab'
  pseudo_dir    = './'
  outdir = '/tmp/qe'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-5
/

&SYSTEM
  ibrav    = 0
  nat      = 24
  ntyp     = 2
  ecutwfc  = 90.0
  ecutrho  = 720.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
/

&ELECTRONS
  conv_thr    = 1.0d-8
  mixing_beta = 0.3
/

