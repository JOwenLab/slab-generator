! Stress-only SCF generated from results/thickness/C110_12L
! Uses final relaxed coordinates; no ionic relaxation.
&CONTROL
  tprnfor       = .true.
  tstress       = .true.
  calculation   = 'scf'
  prefix        = 'slab'
  pseudo_dir    = './'
  outdir = '/tmp/qe'
